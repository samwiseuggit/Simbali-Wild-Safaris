# Server-side AI key for the chatbot. Add these in Coolify Environment Variables.
# Do not expose provider keys as PUBLIC_* variables.
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional comma-separated fallback list. The app also appends openrouter/free.
OPENROUTER_MODELS=openai/gpt-4o-mini,openrouter/free
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Coolify Dockerfile deployment
HOST=0.0.0.0
PORT=3000
