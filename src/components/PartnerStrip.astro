---
const partners = [
  { image: 'image12.png', name: "Governors’ Camp Collection" },
  { image: 'image13.png', name: 'Fairmont Hotels & Resorts' },
  { image: 'image14.png', name: 'Serena Hotels' },
  { image: 'image15.png', name: 'Angama' },
  { image: 'image17.png', name: 'Airkenya' },
  { image: 'image18.png', name: 'Aura' },
];
---

<section class="section partner-section" aria-labelledby="partners-heading">
  <div class="container center">
    <div class="eyebrow">Our Partners</div>
    <h2 id="partners-heading">Relationships That Support the Journey.</h2>
    <p>Hospitality and aviation partners from our company profile. Availability varies by itinerary and season.</p>
    <ul class="partner-directory" aria-label="Hospitality and aviation partners">
      {partners.map((partner) => (
        <li>
          <div class="partner-visual">
            <img class:list={{ wordmark: partner.name === 'Angama' }} src={`/new-simbali-assets/${partner.image}`} alt="" width="280" height="140" />
          </div>
          <span>{partner.name}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .partner-section { background: #fff; }
  .partner-section p { max-width: 680px; margin: 20px auto 30px; }
  .partner-directory { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); list-style: none; padding: 0; margin: 40px auto 0; max-width: 1080px; gap: 24px 32px; }
  .partner-directory li { min-width: 0; padding: 20px 16px; border-top: 1px solid #e4ddcf; }
  .partner-visual { height: 150px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .partner-visual img { width: 100%; max-width: 280px; height: 140px; object-fit: contain; }
  .partner-visual img.wordmark { height: 100px; object-fit: cover; }
  .partner-directory span { display: block; margin-top: 16px; color: #51412c; font-size: .9rem; line-height: 1.5; }
  @media (max-width: 640px) {
    .partner-directory { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 16px; }
    .partner-directory li { padding: 16px 4px; }
    .partner-visual { height: 120px; }
    .partner-visual img { height: 110px; }
    .partner-visual img.wordmark { height: 76px; }
    .partner-directory span { font-size: .8rem; }
  }
</style>
