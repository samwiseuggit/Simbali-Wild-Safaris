---
import NewSimbaliLayout from '../layouts/NewSimbaliLayout.astro';

const seo = {
  "title": "Plan Your First Safari | Kenya vs Tanzania, Migration Timing & Zanzibar",
  "description": "A practical guide to planning your first East Africa safari, including Kenya vs Tanzania, Great Migration timing, safari length, private guiding, travel style and when to add Zanzibar or the Indian Ocean.",
  "keywords": "plan first safari, Kenya vs Tanzania safari, Great Migration timing, when to go on safari, Zanzibar safari extension, East Africa safari planning, safari travel guide",
  "jsonLd": {
    "@type": "Guide",
    "name": "Plan Your First Safari",
    "about": [
      "Safari planning",
      "Kenya vs Tanzania",
      "Great Migration",
      "Bush and beach travel"
    ]
  }
};

const content = "<section class=\"page-hero\" style=\"background-image:url(https://images.unsplash.com/photo-1516214104703-d870798883c5?auto=format&fit=crop&w=2200&q=88)\"><div class=\"container\"><div class=\"eyebrow\" style=\"color:#e4c89b\">Plan Your Safari</div><h1>Your First Journey to Africa, Made Clear.</h1><p>East Africa can feel complex before you go. Our role is to make the decisions simple, the logistics seamless and the experience deeply rewarding.</p></div></section>\n<section class=\"section\" id=\"first-safari\"><div class=\"container grid-2\"><div><div class=\"eyebrow\">First Safari? Start Here.</div><h2>Begin With the Journey, Not the Checklist.</h2><p class=\"lead\">The right safari depends on season, pace, who is traveling, what you want to see and how private you want the experience to feel.</p><p>Most U.S. travelers are best served by 7–14 nights in East Africa, with 9–12 nights often providing the strongest balance of safari depth, travel time and relaxation. Shorter 3–5 night safaris work especially well as add-ons for travelers already in the region.</p></div><div class=\"content-card\"><h3>Questions We Help Answer</h3><p>Which country? When should we go? Migration or gorillas? How many nights? What level of camp? Private vehicle or shared? Safari only or bush + beach? How much should we invest? How far ahead should we book?</p></div></div></section>\n<section class=\"section alt\" id=\"kenya-vs-tanzania\"><div class=\"container\"><div class=\"center\"><h2>Kenya vs. Tanzania</h2><div class=\"section-kicker\">There is no universally better safari—only the better fit for you.</div></div><div class=\"grid-2\"><div class=\"content-card\"><h3>Choose Kenya When…</h3><p>You want a strong first-safari experience, private conservancies, excellent multi-generational flexibility, deep cultural possibilities, or an itinerary that can mix Mara, Laikipia, Amboseli and coast.</p></div><div class=\"content-card\"><h3>Choose Tanzania When…</h3><p>You are drawn to the Serengeti’s scale, the Great Migration, Ngorongoro, classic northern-circuit landscapes or a natural pairing with Zanzibar.</p></div></div></div></section>\n<section class=\"section\" id=\"migration\"><div class=\"container grid-2\"><div><img style=\"height:430px\" src=\"https://images.unsplash.com/photo-1534177616072-ef7dc120449d?auto=format&fit=crop&w=1200&q=85\" alt=\"Great Migration\"></div><div><div class=\"eyebrow\">When to Go</div><h2>The Great Migration Is a Cycle, Not a Single Event.</h2><p class=\"lead\">The best timing depends on the part of the story you want to experience.</p><p>Rather than promising one fixed moment, Simbali designs around season, animal movement, camp location and the trade-off between spectacle, weather, privacy and price. We will advise you on the most appropriate region for your travel window.</p></div></div></section>\n<section class=\"section alt\" id=\"bush-beach\"><div class=\"container grid-2\"><div><div class=\"eyebrow\">Bush + Beach</div><h2>Safari + Zanzibar: The Perfect Combination.</h2><p class=\"lead\">Let the journey change tempo.</p><p>Start with early mornings, wildlife and the energy of the bush. Finish with warm water, beautiful food and slower days on the Indian Ocean. This pairing is especially strong for honeymoons, anniversaries and first-time East Africa travelers.</p></div><div><img style=\"height:430px\" src=\"https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?auto=format&fit=crop&w=1200&q=85\" alt=\"Zanzibar beach\"></div></div></section>\n<section class=\"section\"><div class=\"container\"><div class=\"center\"><h2>How Planning With Simbali Works</h2><div class=\"section-kicker\">A considered process, quietly handled.</div></div><div class=\"timeline\"><div class=\"step\"><div class=\"num\">01</div><h3>Discover</h3><p>We learn who is traveling, why this journey matters and what exceptional means to you.</p></div><div class=\"step\"><div class=\"num\">02</div><h3>Curate</h3><p>We shape the route, camps, guides, experiences, pacing and service level around you.</p></div><div class=\"step\"><div class=\"num\">03</div><h3>Refine</h3><p>We adjust the details until the journey feels right—not simply complete.</p></div><div class=\"step\"><div class=\"num\">04</div><h3>Travel</h3><p>We coordinate the journey and provide in-destination support so you can be present.</p></div></div></div></section>\n<section class=\"final-cta\"><div class=\"container\"><h2>Ready to Move From Research to Planning?</h2><div class=\"section-kicker\">Tell us what you are imagining.</div><a class=\"button gold\" href=\"/design-your-journey/\">Design Your Journey</a></div></section>";
---

<NewSimbaliLayout {...seo}>
  <Fragment set:html={content} />
</NewSimbaliLayout>
