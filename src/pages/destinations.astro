---
import NewSimbaliLayout from '../layouts/NewSimbaliLayout.astro';

const seo = {
  "title": "East Africa Safari Destinations | Kenya, Tanzania, Rwanda, Uganda & Zanzibar",
  "description": "Explore Simbali Wild Safaris destinations across Kenya, Tanzania, Rwanda, Uganda and the Indian Ocean, with guidance on where to go for wildlife, gorilla trekking, culture, private conservancies and bush-to-beach travel.",
  "keywords": "East Africa safari destinations, Kenya safari, Tanzania safari, Rwanda gorilla trekking, Uganda safari, Zanzibar beach extension, Indian Ocean safari, private conservancy safari",
  "jsonLd": {
    "@type": "CollectionPage",
    "name": "East Africa Safari Destinations",
    "about": [
      "Kenya safaris",
      "Tanzania safaris",
      "Rwanda gorilla trekking",
      "Uganda safaris",
      "Zanzibar beach extensions"
    ]
  }
};

const content = "<section class=\"page-hero\" style=\"background-image:url(https://images.unsplash.com/photo-1516426122078-c23e76319801?auto=format&fit=crop&w=2200&q=88)\"><div class=\"container\"><div class=\"eyebrow\" style=\"color:#e4c89b\">Our East Africa</div><h1>Five Ways Into East Africa.</h1><p>We don't try to know all of Africa. We specialize in East Africa—creating private journeys through Kenya, Tanzania, Rwanda, Uganda and the Indian Ocean with the depth and local relationships that make each destination feel personal.</p></div></section>\n<section class=\"section\"><div class=\"container\"><div class=\"grid-2\" id=\"kenya\"><div><div class=\"eyebrow\">Kenya</div><h2>The Original Safari, Reimagined.</h2><p class=\"lead\">Big landscapes, extraordinary wildlife and a depth of culture that rewards travelers who slow down.</p><p>Kenya works beautifully for first-time safari travelers, multi-generational families and milestone journeys. Pair the Maasai Mara with private conservancies, Laikipia, Amboseli or the coast, with private guiding and fly-in connections where they add value.</p><a class=\"button gold\" href=\"/design-your-journey/\">Design Kenya</a></div><div class=\"image-card\"><img src=\"https://images.unsplash.com/photo-1516026672322-bc52d61a55d5?auto=format&fit=crop&w=1200&q=85\" alt=\"Kenya safari\"><h3>Kenya</h3></div></div></div></section>\n<section class=\"section alt\"><div class=\"container\"><div class=\"grid-2\" id=\"tanzania\"><div class=\"image-card\"><img src=\"https://images.unsplash.com/photo-1535338454770-8be927b5a00b?auto=format&fit=crop&w=1200&q=85\" alt=\"Tanzania\"><h3>Tanzania</h3></div><div><div class=\"eyebrow\">Tanzania</div><h2>Serengeti Scale. Private Rhythm.</h2><p class=\"lead\">For travelers drawn to vast wilderness, the Great Migration and iconic northern-circuit landscapes.</p><p>Combine the Serengeti with Ngorongoro, Tarangire or a more private southern experience. Tanzania is especially compelling for couples, photographers and travelers who want safari followed by Zanzibar.</p><a class=\"button olive\" href=\"/design-your-journey/\">Design Tanzania</a></div></div></div></section>\n<section class=\"section\"><div class=\"container\"><div class=\"grid-2\" id=\"rwanda\"><div><div class=\"eyebrow\">Rwanda</div><h2>Rare Encounters, Beautifully Handled.</h2><p class=\"lead\">Gorilla trekking is powerful enough to stand alone—and even richer when woven into a wider East Africa journey.</p><p>We design Rwanda for travelers who value transformative wildlife encounters, refined lodges, strong conservation stories and seamless regional combinations with Kenya or Tanzania.</p><a class=\"button gold\" href=\"/design-your-journey/\">Design Rwanda</a></div><div class=\"image-card\"><img src=\"https://images.unsplash.com/photo-1518709594023-6eab9bab7b23?auto=format&fit=crop&w=1200&q=85\" alt=\"Rwanda\"><h3>Rwanda</h3></div></div></div></section>\n<section class=\"section alt\"><div class=\"container\"><div class=\"grid-2\" id=\"uganda\"><div class=\"image-card\"><img src=\"https://images.unsplash.com/photo-1489392191049-fc10c97e64b6?auto=format&fit=crop&w=1200&q=85\" alt=\"Uganda\"><h3>Uganda</h3></div><div><div class=\"eyebrow\">Uganda</div><h2>Wild, Layered and Unexpected.</h2><p class=\"lead\">Forests, primates, lakes and classic safari create a journey with remarkable range.</p><p>Uganda suits curious travelers who want a more adventurous East Africa story, including gorilla and chimpanzee experiences balanced with comfort, private guidance and thoughtful pacing.</p><a class=\"button olive\" href=\"/design-your-journey/\">Design Uganda</a></div></div></div></section>\n<section class=\"section\"><div class=\"container\"><div class=\"grid-2\" id=\"indian-ocean\"><div><div class=\"eyebrow\">Zanzibar &amp; Indian Ocean</div><h2>From Bush to Barefoot.</h2><p class=\"lead\">A beach extension can turn a safari into a true two-act journey.</p><p>After the early mornings and exhilaration of safari, unwind on the Indian Ocean with private transfers, boutique resorts, exceptional dining and enough time to do very little—or explore culture, spice, sailing and the sea.</p><a class=\"button gold\" href=\"/design-your-journey/\">Design Bush + Beach</a></div><div class=\"image-card\"><img src=\"https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=85\" alt=\"Indian Ocean\"><h3>Zanzibar &amp; Indian Ocean</h3></div></div></div></section>\n<section class=\"final-cta\"><div class=\"container\"><h2>Not Sure Where to Begin?</h2><div class=\"section-kicker\">Tell us what you want to feel. We'll help choose where to go.</div><a class=\"button gold\" href=\"/design-your-journey/\">Design Your Journey</a></div></section>";
---

<NewSimbaliLayout {...seo}>
  <Fragment set:html={content} />
</NewSimbaliLayout>
