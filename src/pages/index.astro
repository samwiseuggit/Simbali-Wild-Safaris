---
import NewSimbaliLayout from '../layouts/NewSimbaliLayout.astro';

const seo = {
  "title": "Luxury East Africa Safaris | Simbali Wild Safaris",
  "description": "Plan a private luxury safari through Kenya, Tanzania, Rwanda, Uganda and Zanzibar with Simbali Wild Safaris, East Africa specialists offering bespoke itineraries, trusted guides and seamless in-destination support.",
  "keywords": "luxury East Africa safari, private African safari, bespoke Kenya safari, Tanzania luxury safari, Rwanda gorilla safari, Uganda primate safari, Zanzibar beach safari, Simbali Wild Safaris",
  "jsonLd": {
    "@type": "WebPage",
    "name": "Luxury East Africa Safaris",
    "about": [
      "Private safaris",
      "East Africa travel planning",
      "Luxury safari itineraries"
    ],
    "primaryImageOfPage": "https://simbaliwildsafaris.com/new-simbali-assets/simbali-wild-safaris-logo-new.png"
  }
};

const content = "<section class=\"hero\"><div class=\"container hero-inner\"><div class=\"hero-copy\"><h1>Africa, Known Personally.</h1><div class=\"tagline\">Private East Africa, Beautifully Curated.</div><p>Bespoke journeys through Kenya, Tanzania, Rwanda, Uganda and the Indian Ocean—designed with local knowledge, personal relationships and white-glove service.</p><div class=\"hero-actions\"><a class=\"button gold\" href=\"/design-your-journey/\">Design Your Journey</a><a class=\"button outline\" href=\"/plan-your-safari/\">Request Our Guide</a></div></div></div></section>\n<section class=\"trust\"><div class=\"container trust-grid\"><div class=\"trust-item\"><span class=\"icon\">♧</span><div><strong>East Africa Specialists</strong><small>Kenya • Tanzania • Rwanda • Uganda</small></div></div><div class=\"trust-item\"><span class=\"icon\">◉</span><div><strong>Bespoke, Private &amp; Personalized</strong></div></div><div class=\"trust-item\"><span class=\"icon\">♢</span><div><strong>24/7 In-Destination Support</strong></div></div><div class=\"trust-item\"><span class=\"icon\">◇</span><div><strong>Travel With Purpose</strong></div></div></div></section>\n<section class=\"section\" id=\"destinations\"><div class=\"container center\"><h2>Our East Africa</h2><div class=\"section-kicker\">Extraordinary Places. Exceptional Journeys.</div><div class=\"cards-5\"><a class=\"destination-card\" href=\"/destinations/#kenya\"><img src=\"https://images.unsplash.com/photo-1516026672322-bc52d61a55d5?auto=format&fit=crop&w=900&q=85\" alt=\"Kenya\"><h3>Kenya</h3></a><a class=\"destination-card\" href=\"/destinations/#tanzania\"><img src=\"https://images.unsplash.com/photo-1535338454770-8be927b5a00b?auto=format&fit=crop&w=900&q=85\" alt=\"Tanzania\"><h3>Tanzania</h3></a><a class=\"destination-card\" href=\"/destinations/#rwanda\"><img src=\"https://images.unsplash.com/photo-1518709594023-6eab9bab7b23?auto=format&fit=crop&w=900&q=85\" alt=\"Rwanda\"><h3>Rwanda</h3></a><a class=\"destination-card\" href=\"/destinations/#uganda\"><img src=\"https://images.unsplash.com/photo-1489392191049-fc10c97e64b6?auto=format&fit=crop&w=900&q=85\" alt=\"Uganda\"><h3>Uganda</h3></a><a class=\"destination-card\" href=\"/destinations/#indian-ocean\"><img src=\"https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=900&q=85\" alt=\"Zanzibar and Indian Ocean\"><h3>Zanzibar &amp;<br>Indian Ocean</h3></a></div><a class=\"button olive\" href=\"/destinations/\">Explore Destinations</a></div></section>\n<section class=\"tiers\" id=\"journeys\"><div class=\"container center\"><h2>Choose Your Level of Exclusivity</h2><div class=\"section-kicker\">Three ways to travel, always designed around you.</div><div class=\"tier-grid\"><article class=\"tier\"><h3>Simbali Signature</h3><div class=\"price\">$7,500 – $12,000 pp</div><p>Private or highly curated safari, premium camps, transfers, guides and concierge.</p><a class=\"button dark-outline\" href=\"/journeys/#signature\">Learn More</a></article><article class=\"tier popular\"><div class=\"badge\">Most Popular</div><h3>Simbali Reserve</h3><div class=\"price\">$12,000 – $25,000 pp</div><p>Private vehicles, luxury camps, fly-in connections, bespoke experiences, premium beach extensions and VIP handling.</p><a class=\"button gold\" href=\"/journeys/#reserve\">Learn More</a></article><article class=\"tier\"><h3>Simbali Private</h3><div class=\"price\">$25,000+ pp</div><p>Ultra-luxury, fully bespoke journeys with private-use villas and camps, unique access and concierge-level, end-to-end service.</p><a class=\"button dark-outline\" href=\"/journeys/#private\">Learn More</a></article></div></div></section>\n<section class=\"personas\" id=\"experience\"><div class=\"container center\"><h2>Who We Travel With</h2><div class=\"section-kicker\">Extraordinary journeys for extraordinary people.</div><div class=\"persona-grid\"><a class=\"persona\" href=\"/experience/#legacy\"><div class=\"persona-media\"><img src=\"https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=700&q=85\" alt=\"The Legacy Family\"></div><div class=\"persona-body\"><h3>The Legacy Family</h3><p>Parents and grandparents creating a once-in-a-lifetime Africa trip for their children and grandchildren.</p></div></a><a class=\"persona\" href=\"/experience/#milestone\"><div class=\"persona-media\"><img src=\"https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=700&q=85\" alt=\"The Milestone Traveler\"></div><div class=\"persona-body\"><h3>The Milestone Traveler</h3><p>40th/50th/60th birthdays, anniversaries, retirement, honeymoons and major celebrations.</p></div></a><a class=\"persona\" href=\"/experience/#couple\"><div class=\"persona-media\"><img src=\"https://images.unsplash.com/photo-1494774157365-9e04c6720e47?auto=format&fit=crop&w=700&q=85\" alt=\"The Africa-Curious Affluent Couple\"></div><div class=\"persona-body\"><h3>The Africa-Curious<br>Affluent Couple</h3><p>Experienced international travelers who have “always wanted to do Africa.”</p></div></a><a class=\"persona\" href=\"/experience/#group\"><div class=\"persona-media\"><img src=\"https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=700&q=85\" alt=\"The Private Group\"></div><div class=\"persona-body\"><h3>The Private Group</h3><p>6–14 friends or families wanting exclusive vehicles, villas/camps and guides.</p></div></a><a class=\"persona\" href=\"/experience/#connected\"><div class=\"persona-media\"><img src=\"https://images.unsplash.com/photo-1531123897727-8f129e1688ce?auto=format&fit=crop&w=700&q=85\" alt=\"The Africa-Connected Executive\"></div><div class=\"persona-body\"><h3>The Africa-Connected<br>Executive</h3><p>Affluent travelers seeking a deeper cultural connection and greater sophistication.</p></div></a></div></div></section>\n<section class=\"difference\" id=\"about\"><div class=\"difference-image\"></div><div class=\"difference-copy\"><h2>The Simbali Difference</h2><div class=\"section-kicker\">Experience East Africa with the people who know it best.</div><ul class=\"difference-list\"><li><strong>Focused Expertise</strong> — We specialize in East Africa.</li><li><strong>Designed Around You</strong> — Every journey is private and personal.</li><li><strong>Access Through Relationships</strong> — Guides, camps and communities we know.</li><li><strong>Effortless Travel</strong> — Seamless planning from the U.S. to Africa.</li><li><strong>Travel With Purpose</strong> — Wildlife, culture and lasting positive impact.</li></ul><a class=\"button gold\" href=\"/about/\">Our Approach</a></div></section>\n<section class=\"circle\" id=\"circle\"><div class=\"container\"><div class=\"circle-title\"><h2>Simbali Circle</h2><div class=\"section-kicker\">A private community for those who love Africa.</div></div><p>Travel with Simbali, and you become part of an exclusive circle with priority planning, first access to special experiences and invitations to private travel events.</p><a class=\"button gold\" href=\"/simbali-circle/\">Join the Circle</a></div></section>\n<section class=\"journal\"><div class=\"container center\"><h2>Inspiration &amp; Expert Guidance</h2><div class=\"section-kicker\">Start dreaming. We’ll take care of the details.</div><div class=\"journal-grid\"><a class=\"journal-card\" href=\"/plan-your-safari/#first-safari\"><img src=\"https://images.unsplash.com/photo-1523805009345-7448845a9e53?auto=format&fit=crop&w=800&q=85\" alt=\"\"><h3>First Safari? Start Here.</h3></a><a class=\"journal-card\" href=\"/plan-your-safari/#kenya-vs-tanzania\"><img src=\"https://images.unsplash.com/photo-1516214104703-d870798883c5?auto=format&fit=crop&w=800&q=85\" alt=\"\"><h3>Kenya vs Tanzania:<br>Which Safari Is Right for You?</h3></a><a class=\"journal-card\" href=\"/plan-your-safari/#migration\"><img src=\"https://images.unsplash.com/photo-1534177616072-ef7dc120449d?auto=format&fit=crop&w=800&q=85\" alt=\"\"><h3>When to Go:<br>The Great Migration Calendar</h3></a><a class=\"journal-card\" href=\"/plan-your-safari/#bush-beach\"><img src=\"https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?auto=format&fit=crop&w=800&q=85\" alt=\"\"><h3>Safari + Zanzibar:<br>The Perfect Combination</h3></a></div><a class=\"button olive\" href=\"/plan-your-safari/\">Explore the Journal</a></div></section>\n<section class=\"final-cta\"><div class=\"container\"><h2>Your East Africa Journey Begins Here</h2><div class=\"section-kicker\">Let’s design something extraordinary.</div><div class=\"hero-actions\" style=\"justify-content:center\"><a class=\"button gold\" href=\"/design-your-journey/\">Design Your Journey</a><a class=\"button outline\" href=\"/plan-your-safari/\">Request Our Guide</a></div></div></section>";
---

<NewSimbaliLayout {...seo}>
  <Fragment set:html={content} />
</NewSimbaliLayout>
