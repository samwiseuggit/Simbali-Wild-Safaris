---
import NewSimbaliLayout from '../layouts/NewSimbaliLayout.astro';

const seo = {
  "title": "Private Safari Journeys | Signature, Reserve & Bespoke Luxury Safaris",
  "description": "Compare Simbali Signature, Reserve, Private and Bespoke safari journey styles, from refined first safaris to ultra-luxury private-use camps, fly-in connections, family legacy safaris and Serengeti-to-Zanzibar escapes.",
  "keywords": "private safari journeys, luxury safari packages, bespoke African safari, family legacy safari, Great Migration safari, Serengeti Zanzibar itinerary, ultra luxury safari East Africa",
  "jsonLd": {
    "@type": "CollectionPage",
    "name": "Private Safari Journeys",
    "about": [
      "Simbali Signature",
      "Simbali Reserve",
      "Simbali Private",
      "Simbali Bespoke"
    ]
  }
};

const content = "<section class=\"page-hero\" style=\"background-image:url(https://images.unsplash.com/photo-1523805009345-7448845a9e53?auto=format&fit=crop&w=2200&q=88)\"><div class=\"container\"><div class=\"eyebrow\" style=\"color:#e4c89b\">Journeys</div><h1>A Starting Point, Never a Template.</h1><p>Every Simbali journey is privately tailored. Our service levels help you choose the degree of privacy, access and exclusivity that feels right; our signature journeys help you imagine what is possible.</p></div></section>\n<section class=\"tiers\"><div class=\"container center\"><h2>Choose Your Level of Exclusivity</h2><div class=\"section-kicker\">Three ways to travel, always designed around you.</div><div class=\"tier-grid\"><article class=\"tier\" id=\"signature\"><h3>Simbali Signature</h3><div class=\"price\">$7,500 – $12,000 pp</div><p>Private or highly curated safari, premium camps, transfers, guides and concierge.</p><a class=\"button dark-outline\" href=\"/design-your-journey/\">Begin Planning</a></article><article class=\"tier popular\" id=\"reserve\"><div class=\"badge\">Most Popular</div><h3>Simbali Reserve</h3><div class=\"price\">$12,000 – $25,000 pp</div><p>Private vehicles, luxury camps, fly-in connections, bespoke experiences, premium beach extensions and VIP handling.</p><a class=\"button gold\" href=\"/design-your-journey/\">Begin Planning</a></article><article class=\"tier\" id=\"private\"><h3>Simbali Private</h3><div class=\"price\">$25,000+ pp</div><p>Ultra-luxury, fully bespoke journeys with private-use villas and camps, unique access and concierge-level, end-to-end service.</p><a class=\"button dark-outline\" href=\"/design-your-journey/\">Begin Planning</a></article></div><div class=\"bespoke-band\"><div><h3>Simbali Bespoke — Call to Curate</h3><p>Begin with a blank page. Dates, party, passions, pace, privacy and investment are all yours to define.</p></div><a class=\"button gold\" href=\"/design-your-journey/\">Call to Curate</a></div></div></section>\n<section class=\"section\"><div class=\"container center\"><h2>Signature Journey Ideas</h2><div class=\"section-kicker\">Curated inspiration for the journey you will make your own.</div></div><div class=\"container\"><div class=\"journey-row\"><div class=\"photo\"><img src=\"https://images.unsplash.com/photo-1516426122078-c23e76319801?auto=format&fit=crop&w=1200&q=85\" alt=\"Kenya\"></div><div class=\"copy\"><div class=\"journey-meta\">9 Nights • First Safari</div><h3>The Soul of Kenya</h3><p>A deeply considered first journey through Kenya, pairing classic wildlife with private conservancies, strong guiding and time to absorb the people and landscapes that give the country its character.</p></div></div><div class=\"journey-row\"><div class=\"photo\"><img src=\"https://images.unsplash.com/photo-1534177616072-ef7dc120449d?auto=format&fit=crop&w=1200&q=85\" alt=\"Migration\"></div><div class=\"copy\"><div class=\"journey-meta\">10 Nights • Wildlife</div><h3>The Great Migration</h3><p>Designed around season and movement rather than a fixed checklist, with strategically chosen camps and private guiding that place the experience ahead of the crowds.</p></div></div><div class=\"journey-row\"><div class=\"photo\"><img src=\"https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?auto=format&fit=crop&w=1200&q=85\" alt=\"Zanzibar\"></div><div class=\"copy\"><div class=\"journey-meta\">11 Nights • Couples</div><h3>Serengeti &amp; Zanzibar</h3><p>Safari intensity followed by Indian Ocean stillness: wildlife, fly-in connections and a beautifully paced beach finish.</p></div></div><div class=\"journey-row\"><div class=\"photo\"><img src=\"https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=1200&q=85\" alt=\"Family\"></div><div class=\"copy\"><div class=\"journey-meta\">12 Nights • Multi-Generational</div><h3>The Family Legacy Safari</h3><p>Private vehicles, flexible days, intergenerational experiences and accommodations chosen so children, parents and grandparents can share Africa without sacrificing comfort.</p></div></div></div></section>\n<section class=\"final-cta\"><div class=\"container\"><h2>Every Journey Is Different Because Every Traveler Is Different.</h2><div class=\"section-kicker\">Use these ideas as inspiration, then make the journey yours.</div><a class=\"button gold\" href=\"/design-your-journey/\">Design Your Journey</a></div></section>";
---

<NewSimbaliLayout {...seo}>
  <Fragment set:html={content} />
</NewSimbaliLayout>
