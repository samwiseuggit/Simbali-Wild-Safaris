---
import NewSimbaliLayout from '../layouts/NewSimbaliLayout.astro';

const seo = {
  "title": "Private Safari Journeys | Signature, Reserve & Bespoke Luxury Safaris",
  "description": "Compare Simbali Signature, Reserve, Private and Bespoke safari journey styles, from refined first safaris to ultra-luxury private-use camps, fly-in connections, family legacy safaris and Serengeti-to-Zanzibar escapes.",
  "keywords": "private safari journeys, luxury safari packages, bespoke African safari, family legacy safari, Great Migration safari, Serengeti Zanzibar itinerary, ultra luxury safari East Africa",
  "jsonLd": {
    "@type": "CollectionPage",
    "name": "Private Safari Journeys",
    "about": [
      "Simbali Signature",
      "Simbali Reserve",
      "Simbali Private",
      "Simbali Bespoke"
    ]
  }
};
---

<NewSimbaliLayout {...seo}>
<section class="page-hero journeys-hero" style="background-image:url(https://images.unsplash.com/photo-1523805009345-7448845a9e53?auto=format&fit=crop&w=2200&q=88)">
<div class="container">
<div class="eyebrow" style="color:#e4c89b">Journeys</div>
<h1>A Starting Point, Never a Template.</h1>
<p>Private journeys, thoughtfully paced. Explore a few starting points, find your level of comfort and let us take care of the details.</p>
</div>
</section>
<section class="section">
<div class="container center">
<h2>Signature Journey Ideas</h2>
<div class="section-kicker">Curated inspiration for the journey you will make your own.</div>
</div>
<div class="container journey-grid">
<div class="journey-row">
<div class="photo">
<img src="https://images.unsplash.com/photo-1516426122078-c23e76319801?auto=format&fit=crop&w=1200&q=85" alt="Kenya">
</div>
<div class="copy">
<div class="journey-meta">9 Nights • First Safari</div>
<h3>The Soul of Kenya</h3>
<p>A deeply considered first journey through Kenya, pairing classic wildlife with private conservancies, strong guiding and time to absorb the people and landscapes that give the country its character.</p>
<a class="text-link" href="/design-your-journey/">Plan a journey like this <span aria-hidden="true">→</span>
</a>
</div>
</div>
<div class="journey-row">
<div class="photo">
<img src="/images/wildebeest-river-crossing-simbali-wild-safaris.jpg" alt="Migration">
</div>
<div class="copy">
<div class="journey-meta">10 Nights • Wildlife</div>
<h3>The Great Migration</h3>
<p>Designed around season and movement rather than a fixed checklist, with strategically chosen camps and private guiding that place the experience ahead of the crowds.</p>
<a class="text-link" href="/design-your-journey/">Plan a journey like this <span aria-hidden="true">→</span>
</a>
</div>
</div>
<div class="journey-row">
<div class="photo">
<img src="https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?auto=format&fit=crop&w=1200&q=85" alt="Zanzibar">
</div>
<div class="copy">
<div class="journey-meta">11 Nights • Couples</div>
<h3>Serengeti &amp; Zanzibar</h3>
<p>Safari intensity followed by Indian Ocean stillness: wildlife, fly-in connections and a beautifully paced beach finish.</p>
<a class="text-link" href="/design-your-journey/">Plan a journey like this <span aria-hidden="true">→</span>
</a>
</div>
</div>
<div class="journey-row">
<div class="photo">
<img src="https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=1200&q=85" alt="Family">
</div>
<div class="copy">
<div class="journey-meta">12 Nights • Multi-Generational</div>
<h3>The Family Legacy Safari</h3>
<p>Private vehicles, flexible days, intergenerational experiences and accommodations chosen so children, parents and grandparents can share Africa without sacrificing comfort.</p>
<a class="text-link" href="/design-your-journey/">Plan a journey like this <span aria-hidden="true">→</span>
</a>
</div>
</div>
</div>
</section>
<section class="tiers">
<div class="container center">
<h2>Choose Your Level of Exclusivity</h2>
<div class="section-kicker">Three ways to travel, always designed around you.</div>
<div class="tier-grid">
<article class="tier" id="signature">
<h3>Simbali Signature</h3>
<div class="price">$7,500 – $12,000 pp</div>
<p>Private or highly curated safari, premium camps, transfers, guides and concierge.</p>
<a class="button dark-outline" href="/design-your-journey/">Begin Planning</a>
</article>
<article class="tier popular" id="reserve">
<div class="badge">Most Popular</div>
<h3>Simbali Reserve</h3>
<div class="price">$12,000 – $25,000 pp</div>
<p>Private vehicles, luxury camps, fly-in connections, bespoke experiences, premium beach extensions and VIP handling.</p>
<a class="button gold" href="/design-your-journey/">Begin Planning</a>
</article>
<article class="tier" id="private">
<h3>Simbali Private</h3>
<div class="price">$25,000+ pp</div>
<p>Ultra-luxury, fully bespoke journeys with private-use villas and camps, unique access and concierge-level, end-to-end service.</p>
<a class="button dark-outline" href="/design-your-journey/">Begin Planning</a>
</article>
</div>
<div class="bespoke-band">
<div>
<h3>Simbali Bespoke - Call to Curate</h3>
<p>Begin with a blank page. Dates, party, passions, pace, privacy and investment are all yours to define.</p>
</div>
<a class="button gold" href="/design-your-journey/">Call to Curate</a>
</div>
</div>
</section>
<section class="section planning-section" id="planning-guide">
<div class="container planning-layout">
<div>
<div class="eyebrow">A little guidance</div>
<h2>Your First Journey, Made Clear.</h2>
<p>From choosing a country to finding the right season, we will help you make the decisions that matter.</p>
<a class="text-link" href="/design-your-journey/">Talk to a safari planner <span aria-hidden="true">→</span>
</a>
</div>
<div class="planning-questions">
<details id="first-safari">
<summary>First safari? Start here.</summary>
<div class="planning-answer">
<p class="lead">The right safari depends on season, pace, who is traveling, what you want to see and how private you want the experience to feel.</p>
<p>Most U.S. travelers are best served by 7–14 nights in East Africa, with 9–12 nights often providing the strongest balance of safari depth, travel time and relaxation. Shorter 3–5 night safaris work especially well as add-ons for travelers already in the region.</p>
<p>Which country? When should we go? Migration or gorillas? How many nights? What level of camp? Private vehicle or shared? Safari only or bush + beach? How much should we invest? How far ahead should we book?</p>
</div>
</details>
<details id="kenya-vs-tanzania">
<summary>Kenya or Tanzania?</summary>
<div class="planning-answer">
<h3>Choose Kenya When…</h3>
<p>You want a strong first-safari experience, private conservancies, excellent multi-generational flexibility, deep cultural possibilities, or an itinerary that can mix Mara, Laikipia, Amboseli and coast.</p>
<h3>Choose Tanzania When…</h3>
<p>You are drawn to the Serengeti’s scale, the Great Migration, Ngorongoro, classic northern-circuit landscapes or a natural pairing with Zanzibar.</p>
</div>
</details>
<details id="migration">
<summary>When should I travel for the migration?</summary>
<div class="planning-answer">
<p class="lead">The best timing depends on the part of the story you want to experience.</p>
<p>Rather than promising one fixed moment, Simbali designs around season, animal movement, camp location and the trade-off between spectacle, weather, privacy and price. We will advise you on the most appropriate region for your travel window.</p>
</div>
</details>
<details id="bush-beach">
<summary>Can I combine safari and the beach?</summary>
<div class="planning-answer">
<p class="lead">Let the journey change tempo.</p>
<p>Start with early mornings, wildlife and the energy of the bush. Finish with warm water, beautiful food and slower days on the Indian Ocean. This pairing is especially strong for honeymoons, anniversaries and first-time East Africa travelers.</p>
</div>
</details>
</div>
</div>
</section>
<section class="section planning-process">
<div class="container">
<div class="center">
<h2>How Planning With Simbali Works</h2>
<div class="section-kicker">A considered process, quietly handled.</div>
</div>
<div class="timeline">
<div class="step">
<div class="num">01</div>
<h3>Discover</h3>
<p>We learn who is traveling, why this journey matters and what exceptional means to you.</p>
</div>
<div class="step">
<div class="num">02</div>
<h3>Curate</h3>
<p>We shape the route, camps, guides, experiences, pacing and service level around you.</p>
</div>
<div class="step">
<div class="num">03</div>
<h3>Refine</h3>
<p>We adjust the details until the journey feels right - not simply complete.</p>
</div>
<div class="step">
<div class="num">04</div>
<h3>Travel</h3>
<p>We coordinate the journey and provide in-destination support so you can be present.</p>
</div>
</div>
</div>
</section>
<section class="final-cta">
<div class="container">
<h2>Every Journey Is Different Because Every Traveler Is Different.</h2>
<div class="section-kicker">Use these ideas as inspiration, then make the journey yours.</div>
<a class="button gold" href="/design-your-journey/">Design Your Journey</a>
</div>
</section>
</NewSimbaliLayout>

<script>
  const openLinkedQuestion = () => {
    let anchor: string;
    try { anchor = decodeURIComponent(window.location.hash.slice(1)); }
    catch { return; }
    const question = document.getElementById(anchor);
    if (question instanceof HTMLDetailsElement) question.open = true;
  };
  openLinkedQuestion();
  window.addEventListener('hashchange', openLinkedQuestion);
</script>
