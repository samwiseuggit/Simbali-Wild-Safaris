---
import NewSimbaliLayout from '../layouts/NewSimbaliLayout.astro';

const seo = {
  "title": "Design Your Journey | Request a Private East Africa Safari Consultation",
  "description": "Start a private safari consultation with Simbali Wild Safaris. Share your destinations, dates, travel style, occasion and investment range so the team can curate a bespoke East Africa journey.",
  "keywords": "design your safari, private safari consultation, bespoke East Africa itinerary, luxury safari quote, plan Kenya Tanzania Rwanda Uganda Zanzibar safari, Simbali inquiry",
  "jsonLd": {
    "@type": "ContactPage",
    "name": "Design Your Journey",
    "about": "Private safari consultation request for bespoke East Africa travel"
  }
};
---

<NewSimbaliLayout {...seo}>
<section class="page-hero" style="background-image:url(/images/baobab-sunset-safari-simbali-wild-safaris.jpg)">
<div class="container">
<div class="eyebrow" style="color:#e4c89b">Design Your Journey</div>
<h1>Tell Us What Would Make It Extraordinary.</h1>
<p>Every Simbali journey begins with you—not with a predetermined itinerary. Share what you are imagining and we will use it to shape the first conversation.</p>
</div>
</section>
<section class="section">
<div class="container">
<div class="form-card">
<form action="#" method="post">
<div class="form-grid">
<div>
<label for="name">Name</label>
<input id="name" name="name" type="text" required>
</div>
<div>
<label for="email">Email</label>
<input id="email" name="email" type="email" required>
</div>
<div>
<label for="destination">Where are you considering?</label>
<select id="destination" name="destination">
<option>Not sure yet</option>
<option>Kenya</option>
<option>Tanzania</option>
<option>Rwanda</option>
<option>Uganda</option>
<option>Zanzibar / Indian Ocean</option>
<option>Multi-country East Africa</option>
</select>
</div>
<div>
<label for="dates">When would you like to travel?</label>
<input id="dates" name="dates" type="text" placeholder="Month / year or travel window">
</div>
<div>
<label for="travelers">How many travelers?</label>
<input id="travelers" name="travelers" type="number" min="1">
</div>
<div>
<label for="party">Who is traveling?</label>
<select id="party" name="party">
<option>Couple</option>
<option>Family</option>
<option>Multi-generational family</option>
<option>Friends / private group</option>
<option>Solo</option>
<option>Executive / affinity group</option>
</select>
</div>
<div class="full">
<label for="occasion">What are you celebrating?</label>
<input id="occasion" name="occasion" type="text" placeholder="Birthday, anniversary, honeymoon, retirement, family gathering, or simply Africa">
</div>
<div class="full">
<label for="experiences">What experiences interest you?</label>
<input id="experiences" name="experiences" type="text" placeholder="Wildlife, migration, gorillas, culture, beach, conservation, photography, food, wellness...">
</div>
<div>
<label for="style">Preferred travel style</label>
<select id="style" name="style">
<option>Exceptional comfort</option>
<option>Luxury / private</option>
<option>Ultra-luxury / private-exclusive</option>
<option>I'd like guidance</option>
</select>
</div>
<div>
<label for="investment">Estimated investment per traveler</label>
<select id="investment" name="investment">
<option>$7,500–$10,000</option>
<option>$10,000–$15,000</option>
<option>$15,000–$25,000</option>
<option>$25,000+</option>
<option>I'd like guidance</option>
</select>
</div>
<div class="full">
<label for="extraordinary">What would make this journey extraordinary for you?</label>
<textarea id="extraordinary" name="extraordinary">
</textarea>
</div>
<div class="full">
<button class="button gold" type="submit">Request a Private Consultation</button>
</div>
</div>
</form>
</div>
</div>
</section>
<section class="section alt">
<div class="container grid-2">
<div>
<h2>Prefer to Begin With a Conversation?</h2>
<p class="lead">Simbali Bespoke — Call to Curate</p>
<p>For travelers who want to begin with a blank page, we can start with a private conversation and build around your dates, party, passions, pace, privacy requirements and preferred investment.</p>
</div>
<div class="contact-box consultation-contact">
<h3>Nairobi</h3>
<p>Kindaruma Road<br>P.O. Box 5109 – 00506<br>Nairobi, Kenya</p>
<p>Tel: +254 (0) 0713 855 818<br>
<a href="mailto:info@simbaliwildsafaris.com">info@simbaliwildsafaris.com</a>
</p>
</div>
</div>
</section>
</NewSimbaliLayout>
